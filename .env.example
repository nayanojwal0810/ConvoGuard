# ConvoGuard Environment Configuration Template
# Copy this file to .env and configure local paths.

# Local dataset directory path (containing train_conversations.parquet, val_conversations.parquet, test_conversations.parquet)
DATA_ROOT=data/raw

# Directory for storing audit reports and metrics
ARTIFACTS_DIR=artifacts

# Logging configuration (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Future persistence configurations (milestones after Phase 1)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DATABASE=convoguard
# REDIS_HOST=localhost
# REDIS_PORT=6379
